# ==============================================================================
# ReliefOS Production Environment Configuration Template
# ==============================================================================
# Copy to `.env` and fill in real values. NEVER commit a real .env.
# Values marked REQUIRED (PROD) must be set explicitly in production;
# development defaults exist for local workflows only.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
# Deployment environment: development | staging | production
# REQUIRED (PROD). Gates fail-closed behavior (auth, cookies, error masking).
ENVIRONMENT=development

# Durable PostgreSQL + PostGIS connection string.
# REQUIRED (PROD). In-memory storage is prohibited in production.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://reliefos:reliefos@localhost:5433/reliefos

# ------------------------------------------------------------------------------
# Authentication & Sessions
# ------------------------------------------------------------------------------
# Secret used to sign session tokens (HMAC-SHA256). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED (PROD). Minimum 32 characters. Must be random; never reuse across
# environments. Rotating it invalidates all active sessions.
RELIEFOS_SECRET_KEY=replace_with_a_secure_random_hex_string_at_least_32_chars_long

# true  -> unauthenticated requests are rejected (401) and fail-closed org
#          resolution is active. REQUIRED (PROD).
# false -> development fallback (demo org resolution, relaxed cookies).
AUTH_ENFORCED=false

# Session token lifetime in seconds (default 24h).
SESSION_DURATION_SECONDS=86400

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# Comma-separated allow-list of trusted frontend origins. REQUIRED (PROD).
# Requests from other origins are rejected when credentials are included.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Agent Runtime (Phase 2A — event outbox)
# ------------------------------------------------------------------------------
# Process pending AgentEvents from the outbox automatically.
EVENT_WORKER_ENABLED=true
# Seconds between outbox polls.
EVENT_WORKER_POLL_SECONDS=5
# Max events claimed per poll cycle.
EVENT_WORKER_BATCH_SIZE=10
# Seconds between stale-claim recovery sweeps.
STALE_EVENT_RECOVERY_INTERVAL_SECONDS=120
# A CLAIMED/PROCESSING event older than this (measured from claim time) is
# considered orphaned and is requeued (or failed after retry exhaustion).
STALE_EVENT_THRESHOLD_SECONDS=300

# ------------------------------------------------------------------------------
# Proactive Intelligence (Phase 2B)
# ------------------------------------------------------------------------------
PROACTIVE_SCHEDULER_ENABLED=true
PROACTIVE_SCAN_INTERVAL_SECONDS=60

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5001
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR. Never log secrets at any level.
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Future AI / Bedrock Configuration (when migrating from local Ollama)
# ------------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
